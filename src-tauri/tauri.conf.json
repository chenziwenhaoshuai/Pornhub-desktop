{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pornhub Desktop",
  "version": "1.0.2",
  "identifier": "local.ph.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pornhub Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#08080b",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:* data:; media-src 'self' http://127.0.0.1:* blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
